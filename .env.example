ODONTO_SUPABASE_URL=https://your-odonto-project.supabase.co
ODONTO_SUPABASE_ANON_KEY=odonto-anon-key
ODONTO_SUPABASE_SERVICE_ROLE_KEY=odonto-service-role-key
ADMIN_SUPABASE_URL=https://your-admin-project.supabase.co
ADMIN_SUPABASE_ANON_KEY=admin-anon-key
ADMIN_SUPABASE_SERVICE_ROLE_KEY=admin-service-role-key
PUBLIC_ODONTO_SUPABASE_URL=https://your-odonto-project.supabase.co
PUBLIC_ODONTO_SUPABASE_ANON_KEY=odonto-anon-key
# Google Calendar administrado para pacientes. Debe ser un cliente OAuth Web con
# redirect autorizado en /oauth/google-calendar/callback. La clave de cifrado es
# exactamente 32 bytes en base64/base64url (o 64 caracteres hexadecimales).
# Se conserva implementado pero permanece fuera del flujo público salvo que este
# interruptor se habilite explícitamente.
GOOGLE_CALENDAR_MANAGED_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=
# Opcional: si falta, se construye con PUBLIC_SITE_URL.
GOOGLE_CALENDAR_REDIRECT_URI=
PUBLIC_TURNSTILE_SITE_KEY=
BOOKING_INTEGRATIONS_ENABLED=false
BOOKING_CONTEXTS_AVAILABLE=false
TURNSTILE_SECRET_KEY=
INTERNAL_JOB_SECRET=replace-with-a-long-random-secret
# Web Push: ambas claves públicas deben ser idénticas y corresponder a la privada.
# Generar el par con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:soporte@example.com
WHATSAPP_VERIFY_TOKEN=replace-with-a-long-random-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_AUTOMATIC_REMINDERS_ENABLED=false
# Optional legacy single-owner restriction. Omit to allow configured memberships.
CITA_SUITE_OWNER_EMAIL=
# Compatibility alias accepted during release transition; do not put a real address in examples.
SABRINA_EMAIL=
ADMIN_EMAIL=admin@example.com
MASTER_EMAIL=juanpabloaltamira@protonmail.com
PUBLIC_SITE_URL=https://app.cita-suite.workers.dev
DEMO_MODE=false
# Mercado Pago (suscripciones). OJO: el access token y el secret del webhook
# son DISTINTOS entre credenciales de prueba y de producción.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_SUBSCRIPTION_AMOUNT_ARS=50000
# test | production. No inferirlo por APP_USR: ese prefijo puede existir en ambos entornos.
MP_ENVIRONMENT=
# Sólo para pruebas locales. No desplegar ni versionar credenciales reales.
MP_TEST_BUYER_USERNAME=
MP_TEST_BUYER_PASSWORD=
# FASE 12: intent nativo de calendario en Android. off (default) | data | type.
# Se prueba por dispositivo con ?ci=data / ?ci=type antes de fijarlo acá.
ANDROID_CALENDAR_INTENT_MODE=off

# Enable only after the booking patient information migration is applied.
BOOKING_INFORMATION_ENABLED=false
