      "html": "<section class=\"ds-calendar\" aria-label=\"Mes de referencia\"><h3 class=\"ds-calendar-heading\">2026</h3><div class=\"ds-calendar-months\"><button class=\"ds-calendar-value\" aria-pressed=\"false\">septiembre</button><button class=\"ds-calendar-value\" aria-pressed=\"true\">octubre</button><button class=\"ds-calendar-value\" aria-pressed=\"false\">noviembre</button></div></section>",
      "css": ".ds-calendar{padding:.4rem;border:1px solid var(--border-strong,#244062);border-radius:.75rem;background:var(--surface-raised,#102842);color:var(--text,#eaf1ff);box-shadow:0 12px 28px #0005;font-family:Inter,system-ui,-apple-system,sans-serif;}.ds-calendar-heading{padding:.2rem;font-size:.9rem;font-weight:600}.ds-calendar-months{display:grid;grid-template-columns:repeat(3,1fr);gap:.25rem}.ds-calendar-value{border:0;background:transparent;color:inherit;min-height:2.5rem;border-radius:.5rem;font-size:.9rem;text-transform:capitalize;cursor:pointer;font-family:Inter,system-ui,-apple-system,sans-serif;}.ds-calendar-value:hover:not(:disabled){background:#213c5b}.ds-calendar-value[aria-pressed=\"true\"]{background:var(--accent-strong,#7c3aed);color:white}.ds-calendar-value:focus-visible{outline:2px solid var(--accent-text,#c4b5fd);outline-offset:-2px}.ds-calendar-value:disabled{opacity:.3;cursor:not-allowed}"
