      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:var(--tap,2.75rem);max-width:100%;border-radius:var(--radius,1rem);padding:.7rem 1.25rem;font-size:.95rem;font-weight:700;line-height:1;white-space:normal;overflow-wrap:anywhere;cursor:pointer;transition:transform 140ms ease,box-shadow 160ms ease,background-color 160ms ease,border-color 160ms ease,opacity 160ms ease;font-family:Inter,system-ui,-apple-system,sans-serif;border:0;background:var(--accent-strong,#7c3aed);color:#fff;box-shadow:var(--shadow-accent,0 14px 30px rgba(124,58,237,.26));}.ds-btn-primary:hover:not(:disabled){background:var(--accent-press,#6d28d9);transform:translateY(-1px)}.ds-btn-primary:focus-visible{outline:2px solid var(--accent-text,#c4b5fd);outline-offset:3px;}.ds-btn-primary:active:not(:disabled){transform:translateY(0) scale(.99)}.ds-btn-primary:disabled{cursor:not-allowed;opacity:.45;transform:none;box-shadow:none}@media(prefers-reduced-motion:reduce){.ds-btn-primary{transition:none}}"
