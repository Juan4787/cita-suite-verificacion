      "html": "<section class=\"ds-card\"><h2 class=\"ds-card-title\">Reglas para reservar</h2><p class=\"ds-card-text\">Configuración de la agenda del consultorio.</p></section>",
      "css": ".ds-card{border:1px solid var(--border-strong,#244062);border-radius:var(--radius-lg,1.4rem);padding:1.25rem;color:var(--text,#eaf1ff);background:radial-gradient(circle at top left,rgba(124,58,237,.14),transparent 32rem),linear-gradient(150deg,var(--surface,#0b1d32) 0%,#071626 100%);box-shadow:var(--shadow,0 18px 48px rgba(0,0,0,.28));font-family:Inter,system-ui,-apple-system,sans-serif;}.ds-card-title{font-size:1.15rem;font-weight:700;letter-spacing:-.01em}.ds-card-text{color:var(--text-muted,rgba(234,241,255,.64));font-size:.95rem;line-height:1.55}@media(min-width:640px){.ds-card{padding:1.5rem}}"
