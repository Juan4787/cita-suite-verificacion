{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:cloudflare": "pnpm run build:cloudflare && wrangler dev",
		"build": "vite build",
		"build:cloudflare": "CLOUDFLARE_WORKERS=1 vite build",
		"preview": "vite preview",
		"deploy:cloudflare": "pnpm run build:cloudflare && wrangler deploy",
		"deploy:cloudflare:preview": "pnpm run build:cloudflare && wrangler versions upload",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:e2e": "tsc -p e2e/tsconfig.json",
		"test": "vitest run",
		"test:client": "vitest run --config vitest.client.config.ts",
		"preflight:staging": "node scripts/staging-preflight.mjs",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui"
	},
	"devDependencies": {
		"@playwright/test": "^1.57.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.19",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.2.10",
		"@testing-library/user-event": "^14.6.1",
		"@types/web-push": "^3.6.4",
		"autoprefixer": "^10.4.20",
		"fflate": "0.8.3",
		"jsdom": "^27.3.0",
		"postcss": "^8.5.25",
		"svelte": "^5.55.7",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^3.4.17",
		"typescript": "^5.9.3",
		"vite": "^7.3.5",
		"vitest": "^4.0.16",
		"wrangler": "4.86.0"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.87.1",
		"@cita-suite/shared": "workspace:*",
		"pdf-lib": "^1.17.1",
		"web-push": "^3.6.7",
		"write-excel-file": "4.1.1"
	}
}
