{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "app",
	"account_id": "52b358653379c162b5a07b10ae5e84b3",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"compatibility_date": "2026-05-03",
	"compatibility_flags": ["nodejs_compat"],
	"placement": {
		"region": "aws:sa-east-1"
	},
	"vars": {
		"PUBLIC_SITE_URL": "https://app.cita-suite.workers.dev",
		"BOOKING_CONTEXTS_AVAILABLE": "true",
		"BOOKING_INTEGRATIONS_ENABLED": "true",
		"BOOKING_INFORMATION_ENABLED": "true"
	},
	"keep_vars": true
}
