---
import { referenceServices, referenceArticles } from '../lib/reference-content';
import { courses } from '../lib/courses';
import ServiceDetail from './ServiceDetail.astro';
import CourseDetail from './CourseDetail.astro';
import ContactChannels from './ContactChannels.astro';
import ClassroomPreview from './ClassroomPreview.astro';
import BookingLink from './BookingLink.astro';
---
{referenceServices.map(s => <dialog class="public-dialog" id={`service-${s.id}`} aria-labelledby={`service-title-${s.id}`}><div class="modal-dialog"><div class="modal-header"><div><h3 id={`service-title-${s.id}`}>{s.title}</h3><span class="sub">{s.modality}</span></div><button class="modal-close-btn" type="button" data-close-dialog aria-label="Cerrar detalle"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div><div class="modal-body"><ServiceDetail service={s}/></div></div></dialog>)}
{Object.entries(referenceArticles).map(([id, article]) => <dialog class="public-dialog" id={`article-${id}`} aria-labelledby={`article-title-${id}`}><div class="modal-dialog modal-dialog--read"><div class="modal-header"><div><span class="reader-cat">{article.category}</span><h3 id={`article-title-${id}`}>{article.title}</h3></div><button class="modal-close-btn" type="button" data-close-dialog aria-label="Cerrar nota"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div><div class="modal-body reader-body" set:html={article.content}/><div class="modal-footer"><button class="btn btn-ghost btn-sm" data-close-dialog type="button">Cerrar</button><BookingLink class="btn btn-primary btn-sm" label="Hablarlo en consulta"/></div></div></dialog>)}
{courses.map(course => <dialog class="public-dialog" id={`course-${course.id}`} aria-labelledby={`course-title-${course.id}`}><div class="modal-dialog"><div class="modal-header"><h3 id={`course-title-${course.id}`}>{course.name}</h3><button class="modal-close-btn" type="button" data-close-dialog aria-label="Cerrar curso"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div><div class="modal-body"><CourseDetail course={course}/></div></div></dialog>)}
<dialog class="public-dialog" id="contact-dialog" aria-labelledby="contact-dialog-title"><div class="modal-dialog"><div class="modal-header"><h3 id="contact-dialog-title">Contacto y reservas</h3><button class="modal-close-btn" type="button" data-close-dialog aria-label="Cerrar contacto"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div><div class="modal-body"><ContactChannels/></div></div></dialog>
<dialog class="public-dialog" id="classroom-preview" aria-labelledby="classroom-preview-title"><div class="modal-dialog"><div class="modal-header"><h3 id="classroom-preview-title">Conocé el aula virtual</h3><button class="modal-close-btn" type="button" data-close-dialog aria-label="Cerrar presentación del aula"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div><div class="modal-body"><ClassroomPreview/></div></div></dialog>
