---
import { bookingConfig } from '../lib/booking-config';
interface Props { class?: string; label?: string }
const { class: className = 'btn btn-primary', label = 'Reservar consulta' } = Astro.props;
---
<a class={className} href={bookingConfig.href} data-booking>{label}<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7" /></svg></a>
